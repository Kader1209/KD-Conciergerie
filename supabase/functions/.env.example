# --- Virement bancaire (Edge Function bank-transfer-info) ---
# Tant que BANK_TRANSFER_MODE n'est pas explicitement à "live", la fonction
# renvoie des coordonnées de TEST clairement factices et `mode: "test"`.
BANK_TRANSFER_MODE=test
BANK_TRANSFER_BENEFICIARY=KD CONCIERGERIE (TEST)
BANK_TRANSFER_IBAN=FR76 0000 0000 0000 0000 0000 000
BANK_TRANSFER_BIC=TESTFRP1XXX
BANK_TRANSFER_BANK_NAME=Banque de Test KD
BANK_TRANSFER_BANK_ADDRESS=1 rue de la Démonstration, 75000 Paris (TEST)
BANK_TRANSFER_REFERENCE_PREFIX=KD-TEST
BANK_TRANSFER_SUPPORT_EMAIL=contact@kd-conciergerie.example
# Optionnel : table de log des demandes de virement (créez-la si vous voulez tracer).
SUPABASE_BANK_TRANSFER_TABLE=bank_transfer_requests
