STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

SUPABASE_URL=https://oyhddkzdnwxbectbdzdl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_CHECKOUT_TABLE=stripe_checkout_sessions

# --- Virement bancaire (Edge Function bank-transfer-info) ---
# Tant que BANK_TRANSFER_MODE n'est pas explicitement à "live", la fonction
# renvoie des coordonnées de TEST clairement factices et `mode: "test"`.
BANK_TRANSFER_MODE=test
BANK_TRANSFER_BENEFICIARY=KD CONCIERGERIE (TEST)
BANK_TRANSFER_IBAN=FR76 0000 0000 0000 0000 0000 000
BANK_TRANSFER_BIC=TESTFRP1XXX
BANK_TRANSFER_BANK_NAME=Banque de Test KD
BANK_TRANSFER_BANK_ADDRESS=1 rue de la Démonstration, 75000 Paris (TEST)
BANK_TRANSFER_REFERENCE_PREFIX=KD-TEST
BANK_TRANSFER_SUPPORT_EMAIL=contact@kd-conciergerie.example
# Optionnel : table de log des demandes de virement (créez-la si vous voulez tracer).
SUPABASE_BANK_TRANSFER_TABLE=bank_transfer_requests

# --- Accueil automatique (e-mail + SMS après paiement Stripe ou demande virement) ---
# Resend : https://resend.com — domaine d’expédition vérifié obligatoire pour la prod.
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL="KD Conciergerie <noreply@votredomaine.com>"
# Twilio : https://www.twilio.com — numéro SMS actif (format E.164, ex. +33612345678).
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
TWILIO_FROM_NUMBER=+33600000000
# Libellé affiché dans le message (ex. prénom de l’hôte ou « l’équipe KD »).
KD_HOST_LABEL=votre hôte
